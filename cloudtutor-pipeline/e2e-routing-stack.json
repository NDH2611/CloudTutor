{
    "Description":  "CloudTutor isolated E2E routing",
    "AWSTemplateFormatVersion":  "2010-09-09",
    "Resources":  {
                      "MediaRule":  {
                                        "Properties":  {
                                                           "Targets":  [
                                                                           {
                                                                               "Id":  "ocr-test",
                                                                               "Arn":  "arn:aws:lambda:ap-southeast-1:251929332061:function:lambda-cloudtutor-test-ocr-c6491b01"
                                                                           }
                                                                       ],
                                                           "Name":  "event-cloudtutor-e2e-frames",
                                                           "EventPattern":  {
                                                                                "detail":  {
                                                                                               "userMetadata":  {
                                                                                                                    "stage":  [
                                                                                                                                  "extract-frames"
                                                                                                                              ],
                                                                                                                    "project":  [
                                                                                                                                    "cloudtutor-e2e"
                                                                                                                                ]
                                                                                                                },
                                                                                               "status":  [
                                                                                                              "COMPLETE",
                                                                                                              "ERROR"
                                                                                                          ]
                                                                                           },
                                                                                "source":  [
                                                                                               "aws.mediaconvert"
                                                                                           ],
                                                                                "detail-type":  [
                                                                                                    "MediaConvert Job State Change"
                                                                                                ]
                                                                            },
                                                           "State":  "ENABLED"
                                                       },
                                        "Type":  "AWS::Events::Rule"
                                    },
                      "CompletionPermission":  {
                                                   "Properties":  {
                                                                      "SourceAccount":  "251929332061",
                                                                      "Principal":  "events.amazonaws.com",
                                                                      "SourceArn":  {
                                                                                        "Fn::GetAtt":  [
                                                                                                           "TranscribeRule",
                                                                                                           "Arn"
                                                                                                       ]
                                                                                    },
                                                                      "Action":  "lambda:InvokeFunction",
                                                                      "FunctionName":  "arn:aws:lambda:ap-southeast-1:251929332061:function:lambda-cloudtutor-test-completion-c6491b01"
                                                                  },
                                                   "Type":  "AWS::Lambda::Permission"
                                               },
                      "ReadTestVideos":  {
                                             "Properties":  {
                                                                "PolicyName":  "cloudtutor-e2e-read-videos",
                                                                "PolicyDocument":  {
                                                                                       "Version":  "2012-10-17",
                                                                                       "Statement":  [
                                                                                                         {
                                                                                                             "Effect":  "Allow",
                                                                                                             "Resource":  "arn:aws:s3:::s3-cloudtutor-media-251929332061/e2e-videos/*",
                                                                                                             "Action":  "s3:GetObject"
                                                                                                         }
                                                                                                     ]
                                                                                   },
                                                                "Roles":  [
                                                                              "role-cloudtutor-extract-frames",
                                                                              "role-cloudtutor-process-frames",
                                                                              "role-cloudtutor-transcription-result",
                                                                              "role-cloudtutor-transcription-worker"
                                                                          ]
                                                            },
                                             "Type":  "AWS::IAM::Policy"
                                         },
                      "TranscribeRule":  {
                                             "Properties":  {
                                                                "Targets":  [
                                                                                {
                                                                                    "Id":  "completion-test",
                                                                                    "Arn":  "arn:aws:lambda:ap-southeast-1:251929332061:function:lambda-cloudtutor-test-completion-c6491b01"
                                                                                }
                                                                            ],
                                                                "Name":  "event-cloudtutor-e2e-transcription",
                                                                "EventPattern":  {
                                                                                     "detail":  {
                                                                                                    "TranscriptionJobStatus":  [
                                                                                                                                   "COMPLETED",
                                                                                                                                   "FAILED"
                                                                                                                               ],
                                                                                                    "TranscriptionJobName":  [
                                                                                                                                 {
                                                                                                                                     "prefix":  "transcribe-ct-e2e-"
                                                                                                                                 }
                                                                                                                             ]
                                                                                                },
                                                                                     "source":  [
                                                                                                    "aws.transcribe"
                                                                                                ],
                                                                                     "detail-type":  [
                                                                                                         "Transcribe Job State Change"
                                                                                                     ]
                                                                                 },
                                                                "State":  "ENABLED"
                                                            },
                                             "Type":  "AWS::Events::Rule"
                                         },
                      "OcrPermission":  {
                                            "Properties":  {
                                                               "SourceAccount":  "251929332061",
                                                               "Principal":  "events.amazonaws.com",
                                                               "SourceArn":  {
                                                                                 "Fn::GetAtt":  [
                                                                                                    "MediaRule",
                                                                                                    "Arn"
                                                                                                ]
                                                                             },
                                                               "Action":  "lambda:InvokeFunction",
                                                               "FunctionName":  "arn:aws:lambda:ap-southeast-1:251929332061:function:lambda-cloudtutor-test-ocr-c6491b01"
                                                           },
                                            "Type":  "AWS::Lambda::Permission"
                                        },
                      "TestTranscribeAccess":  {
                                                   "Properties":  {
                                                                      "PolicyName":  "cloudtutor-e2e-transcribe",
                                                                      "PolicyDocument":  {
                                                                                             "Version":  "2012-10-17",
                                                                                             "Statement":  [
                                                                                                               {
                                                                                                                   "Effect":  "Allow",
                                                                                                                   "Resource":  "arn:aws:transcribe:ap-southeast-1:251929332061:transcription-job/transcribe-ct-e2e-*",
                                                                                                                   "Action":  [
                                                                                                                                  "transcribe:StartTranscriptionJob",
                                                                                                                                  "transcribe:GetTranscriptionJob"
                                                                                                                              ]
                                                                                                               }
                                                                                                           ]
                                                                                         },
                                                                      "Roles":  [
                                                                                    "role-cloudtutor-transcription-result",
                                                                                    "role-cloudtutor-transcription-worker"
                                                                                ]
                                                                  },
                                                   "Type":  "AWS::IAM::Policy"
                                               }
                  }
}