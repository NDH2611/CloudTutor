{
  "Name": "mediaconvert-cloudtutor-extract-frames",
  "Description": "CloudTutor OCR and Vision frame extraction",
  "Settings": {
    "TimecodeConfig": {
      "Source": "ZEROBASED"
    },
    "Inputs": [
      {
        "TimecodeSource": "ZEROBASED",
        "VideoSelector": {}
      }
    ],
    "OutputGroups": [
      {
        "Name": "CloudTutorFrames",
        "OutputGroupSettings": {
          "Type": "FILE_GROUP_SETTINGS",
          "FileGroupSettings": {}
        },
        "Outputs": [
          {
            "NameModifier": "_frame",
            "ContainerSettings": {
              "Container": "RAW"
            },
            "VideoDescription": {
              "CodecSettings": {
                "Codec": "FRAME_CAPTURE",
                "FrameCaptureSettings": {
                  "FramerateNumerator": 1,
                  "FramerateDenominator": 5,
                  "MaxCaptures": 60,
                  "Quality": 85
                }
              }
            }
          }
        ]
      },
      {
        "Name": "CloudTutorDerived",
        "OutputGroupSettings": {
          "Type": "FILE_GROUP_SETTINGS",
          "FileGroupSettings": {}
        },
        "Outputs": [
          {
            "NameModifier": "_derived",
            "ContainerSettings": {
              "Container": "MP4"
            },
            "VideoDescription": {
              "Width": 640,
              "Height": 360,
              "CodecSettings": {
                "Codec": "H_264",
                "H264Settings": {
                  "RateControlMode": "CBR",
                  "Bitrate": 500000,
                  "CodecProfile": "MAIN",
                  "CodecLevel": "AUTO",
                  "FramerateControl": "INITIALIZE_FROM_SOURCE",
                  "GopSize": 2,
                  "GopSizeUnits": "SECONDS",
                  "GopClosedCadence": 1
                }
              }
            }
          }
        ]
      }
    ]
  }
}