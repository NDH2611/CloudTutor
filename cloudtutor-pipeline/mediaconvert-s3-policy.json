{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::s3-cloudtutor-media-251929332061"
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::s3-cloudtutor-media-251929332061/videos/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::s3-cloudtutor-media-251929332061/frames/*",
        "arn:aws:s3:::s3-cloudtutor-media-251929332061/derived/*"
      ]
    }
  ]
}