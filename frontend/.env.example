# CloudTutor Frontend Environment Variables

# Backend API Gateway endpoint (leave blank to run in mock mode)
VITE_API_BASE_URL=

# AWS Cognito User Pool configuration
# When set, the app connects directly using amazon-cognito-identity-js SDK
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-southeast-1

# Force Mock mode (true/false)
VITE_USE_MOCK=true
